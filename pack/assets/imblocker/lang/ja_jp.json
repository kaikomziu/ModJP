{
  "text.autoconfig.imblocker.title": "IMBlocker 設定",
  "text.autoconfig.imblocker.option.basicSettings": "基本設定",
  "text.autoconfig.imblocker.option.basicSettings.screenWhitelist": "画面ホワイトリスト",
  "text.autoconfig.imblocker.option.basicSettings.screenWhitelist.@Tooltip": "リストにある画面ではIMEが有効になります。",
  "text.autoconfig.imblocker.option.basicSettings.enableScreenRecovering": "画面の記録を有効化",
  "text.autoconfig.imblocker.option.basicSettings.recoveredScreens": "記録された画面",
  "text.autoconfig.imblocker.option.basicSettings.recoveredScreens.@Tooltip": "ホワイトリスト編集用に、記録されたすべての画面を表示します。",
  "text.autoconfig.imblocker.option.basicSettings.englishStateImpl": "英数モードの切替方式",
  "text.autoconfig.imblocker.option.basicSettings.englishStateImpl.@Tooltip[0]": "§l英数モードに切り替える方法。",
  "text.autoconfig.imblocker.option.basicSettings.englishStateImpl.@Tooltip[1]": "「CONVERSION_STATUS」は基本的にMicrosoft IMEの利用者にのみ推奨されます。\n「RIME」はWeasel・Squirrel・fcitx5-rime向けの主な選択肢です。",
  "text.autoconfig.imblocker.option.basicSettings.englishStateImpl.@Tooltip[2]": "IMEが正常に英数モードへ自動で切り替わらない場合は、\n「DISABLE_IM」を選び、ホットキー(デフォルトは右Shift)でIMEを手動で解除してください。",
  "text.autoconfig.imblocker.option.basicSettings.primaryEnglishState": "初期の英数モード",
  "text.autoconfig.imblocker.option.basicSettings.primaryEnglishState.@Tooltip[0]": "§l入力欄にフォーカスしたときのIMEの初期の英数モード。",
  "text.autoconfig.imblocker.option.basicSettings.primaryEnglishState.@Tooltip[1]": "主にJEChで検索し慣れている中国語ユーザー向けのオプションです。",
  "text.autoconfig.imblocker.option.basicSettings.primaryEnglishState.@Tooltip[2]": "チャット欄や検索場面の少ないMODには影響しません。",
  "text.autoconfig.imblocker.option.advanceSettings": "高度な設定",
  "text.autoconfig.imblocker.option.advanceSettings.charSimulationScreens": "文字シミュレーション優先の画面",
  "text.autoconfig.imblocker.option.advanceSettings.charSimulationScreens.@Tooltip[0]": "§l文字シミュレーションでフォーカスを特定する画面。",
  "text.autoconfig.imblocker.option.advanceSettings.charSimulationScreens.@Tooltip[1]": "リストの画面では、文字シミュレーション(精度100%の方法)で\n画面内のフォーカス先を特定します。\n通常、調査用の文字は注入処理で安全に吸収されますが、\n場面によっては互換性の問題が起きることがあります。",
  "text.autoconfig.imblocker.option.advanceSettings.commandPrefixRegex": "コマンド接頭辞の正規表現",
  "text.autoconfig.imblocker.option.modCompatibilitySettings": "MOD互換性設定",
  "text.autoconfig.imblocker.option.modCompatibilitySettings.sfm$showLineNumber": "SFM: 行番号を表示",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings": "Windows互換性設定",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableConversionStatusApi": "ConversionStatus APIを許可",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableConversionStatusApi.@Tooltip": "英数モードを制御するAPIです。\n§7無効にすると、CONVERSION_STATUS方式の切替は動作しません。",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableCursorPositionTracking": "カーソル位置の追跡",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableCompositionFontTweaks": "変換中フォントの調整",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableIngameIME": "ゲーム内IMEを有効化",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableIngameIME.@Tooltip[0]": "§l排他的フルスクリーン時に変換候補を独自に描画",
  "text.autoconfig.imblocker.option.windowsCompatibilitySettings.enableIngameIME.@Tooltip[1]": "排他的フルスクリーンでIMEの変換候補ウィンドウが見えない場合のみ推奨。\nIMEの変換候補ウィンドウの方が機能は豊富です。",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings": "Linux互換性設定",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.enableKeyboardPatch": "コールバックレベルのキーボードパッチを有効化",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.enableKeyboardPatch.@Tooltip[0]": "変換候補の表示中に、文字以外のキーがゲームに送られないようにするパッチを適用します",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.enableKeyboardPatch.@Tooltip[1]": "Backspaceで未確定文字を消して変換候補ウィンドウが閉じた場合、\nゲームが文字以外のキーを処理できなくなります。\nその場合はEscを押すか、何か文字を入力すると直ります。",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.ibusOnArgName": "IBus 有効化コマンドの引数",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.ibusOnArgName.@Tooltip": "確認方法:\nターミナルで「ibus engine <この引数>」を実行するとIMEが有効になります。",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.ibusOffArgName": "IBus 無効化コマンドの引数",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.ibusOffArgName.@Tooltip": "確認方法:\nターミナルで「ibus engine <この引数>」を実行するとIMEが無効になります。",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.fcitx5OnArgName": "Fcitx5 有効化コマンドの引数",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.fcitx5OnArgName.@Tooltip": "確認方法:\nターミナルで「fcitx5-remote <この引数>」を実行するとIMEが有効になります。",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.fcitx5OffArgName": "Fcitx5 無効化コマンドの引数",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.fcitx5OffArgName.@Tooltip": "確認方法:\nターミナルで「fcitx5-remote <この引数>」を実行するとIMEが無効になります。",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.fcitx5OnStateName": "Fcitx5 有効状態の識別子",
  "text.autoconfig.imblocker.option.linuxCompatibilitySettings.fcitx5OnStateName.@Tooltip": "確認方法:\nターミナルで「fcitx5-remote」を実行すると<この引数>が返ります。",
  "key.categories.imblocker": "IMBlocker",
  "key.unlockIME": "IMEのロック解除"
}